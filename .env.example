# ==============================================================================
# HIREMIND ENTERPRISE — PRODUCTION CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. Server Ports
FRONTEND_PORT=3009
BACKEND_PORT=8010
APP_ENV=production

# 2. MySQL Database Configuration (Local & Ubuntu Server)
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123@
DB_NAME=jobai_db

# 3. Multilingual AI Engines (motapis.com/v1 / Claude / DeepSeek)
AI_BASE_URL=https://motapis.com/v1
AI_API_KEY=your_ai_api_key_here
AI_DEFAULT_MODEL=claude-sonnet-4-6
AI_FALLBACK_MODEL=DeepSeek-V4-Flash-0731
AI_ENABLED=true

# 4. Vietnam Omnichannel & Notification Gateways (Zalo ZNS & SMTP)
ZALO_OA_ID=your_zalo_official_account_id
ZALO_ZNS_ACCESS_TOKEN=your_zalo_zns_token_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hr-noreply@company.vn
SMTP_PASSWORD=your_smtp_app_password

# 5. Security, JWT & Vietnam PDPD Decree 13/2023/ND-CP Compliance
JWT_SECRET_KEY=change_this_to_a_256_bit_production_secret
PDPD_DATA_RETENTION_DAYS=365
