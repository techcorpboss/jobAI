# ==============================================================================
# HIREMIND ENTERPRISE — PRODUCTION CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. Server Ports
FRONTEND_PORT=3009
BACKEND_PORT=8010
APP_ENV=production

# 2. Database & Vector Engine (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+psycopg://hiremind:hiremind_secret_2026@postgres:5432/hiremind_vn
REDIS_URL=redis://redis:6379/0

# 3. Multilingual AI Engines (Gemini 2.5 Flash / OpenAI GPT-4o / BGE-M3)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=BAAI/bge-m3

# 4. Vietnam Omnichannel & Notification Gateways (Zalo ZNS & SMTP)
ZALO_OA_ID=your_zalo_official_account_id
ZALO_ZNS_ACCESS_TOKEN=your_zalo_zns_token_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hr-noreply@company.vn
SMTP_PASSWORD=your_smtp_app_password

# 5. Security, JWT & Vietnam PDPD Decree 13/2023/ND-CP Compliance
JWT_SECRET_KEY=change_this_to_a_256_bit_production_secret
PDPD_DATA_RETENTION_DAYS=365
